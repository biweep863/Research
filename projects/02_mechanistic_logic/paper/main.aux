\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cross-surface transfer. Training on one surface and testing on the other still beats chance at every depth past the embedding layer, peaking at $0.669$ (English $\to $ conlang) and $0.594$ (conlang $\to $ English). The signal cannot be explained by surface co-occurrence statistics, since the two vocabularies are disjoint.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:cross}{{2}{3}{Cross-surface transfer. Training on one surface and testing on the other still beats chance at every depth past the embedding layer, peaking at $\gptTwoCrossEnCl $ (English $\to $ conlang) and $\gptTwoCrossClEn $ (conlang $\to $ English). The signal cannot be explained by surface co-occurrence statistics, since the two vocabularies are disjoint}{figure.caption.2}{}}
